{
  "type": "object",
  "properties": {
    "prd": {
      "type": "string"
    },
    "roadmap": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "project": {
          "type": "string"
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "priority": {
                "type": "integer",
                "minimum": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "todo"
                ]
              },
              "acceptance": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "title",
              "priority",
              "status",
              "acceptance",
              "depends_on"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "project",
        "tasks"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "prd",
    "roadmap"
  ],
  "additionalProperties": false
}
