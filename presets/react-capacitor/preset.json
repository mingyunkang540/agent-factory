{
  "schema_version": 1,
  "name": "react-capacitor",
  "supported": true,
  "base": "react-web",
  "commands": {
    "install": {
      "args": ["ci"],
      "file": "npm"
    },
    "lint": {
      "args": [
        "run",
        "lint"
      ],
      "file": "npm"
    },
    "typecheck": {
      "args": [
        "run",
        "typecheck"
      ],
      "file": "npm"
    },
    "test": {
      "args": [
        "run",
        "test"
      ],
      "file": "npm"
    },
    "build": {
      "args": [
        "run",
        "build"
      ],
      "file": "npm"
    }
  }
}
